# ============================================================
# 密钥环境变量模板
# 用法：在操作系统环境变量中配置以下变量（代码通过 os.getenv 读取，
# 不会自动加载本文件）。切勿把真实密钥写进代码或提交到仓库。
# 检索/分类/题库等离线功能不依赖密钥；仅 LLM 问答与出题需要。
# ============================================================

# DeepSeek
DEEPSEEK_API_KEY=

# 智谱 GLM
ZHIPU_API_KEY=

# ModelScope
MODELSCOPE_API_KEY=

# 以下为可选覆盖项，留空则使用代码内默认值
# DEEPSEEK_API_URL=
# ZHIPU_API_URL=
# MODELSCOPE_API_URL=
# DEEPSEEK_MODEL=
# ZHIPU_MODEL=
# MODELSCOPE_MODEL=
